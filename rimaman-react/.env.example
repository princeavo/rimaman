# URL de l'API backend RIMAMAN
VITE_API_URL=http://localhost:3000

# Google Analytics 4 Tracking ID
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# EmailJS Configuration (for contact form)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# WhatsApp Number (without + or spaces)
VITE_WHATSAPP_NUMBER=229XXXXXXXX

# Payment Provider (fedapay or kkiapay)
VITE_PAYMENT_PROVIDER=fedapay

# FedaPay Configuration
# Get your keys at: https://fedapay.com/dashboard/developers
VITE_FEDAPAY_PUBLIC_KEY=pk_sandbox_your_public_key_here
VITE_FEDAPAY_SANDBOX=true

# KKiaPay Configuration
# Get your keys at: https://kkiapay.me/dashboard
VITE_KKIAPAY_PUBLIC_KEY=your_public_key_here
VITE_KKIAPAY_SANDBOX=true
