# Base de données (correspond à docker-compose.yml pour le dev local)
DATABASE_URL="postgresql://rimaman:rimaman_dev_password@localhost:5432/rimaman?schema=public"

# Serveur
PORT=3000
NODE_ENV=development

# Origine autorisée pour le CORS (URL du frontend)
FRONTEND_ORIGIN=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Compte admin créé par le script de seed (mot de passe haché à la création, jamais stocké en clair)
SEED_ADMIN_EMAIL=admin@rimaman.com
SEED_ADMIN_PASSWORD=change_me_before_seeding

# Stockage des médias (local en dev — voir StorageService pour un futur stockage S3-compatible)
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_PATH=./uploads
MEDIA_PUBLIC_URL=http://localhost:3000/uploads

# Email (notifications de commande/contact)
# SMTP — laisser SMTP_HOST vide pour désactiver les emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL_FROM=commandes@rimaman.com
NOTIFICATION_EMAIL_TO=aanselme92@gmail.com

# WhatsApp Business Cloud API (activable une fois le compte Meta validé)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT_NUMBER=2290140692269
